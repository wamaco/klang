# splitWordsGo :: String -> Int -> String -> [String] -> [String]
let splitWordsGo text i current ret =
  if i >= str_len text then
    if current == "" then
      ret
    else
      append ret [current]
  else
    let c = lowerAlpha (str_at text i) in
    if c == "" then
      if current == "" then
        splitWordsGo text (i + 1) "" ret
      else
        splitWordsGo text (i + 1) "" (append ret [current])
    else
      splitWordsGo
        text
        (i + 1)
        (str_concat current c)
        ret;

# splitWords :: String -> [String]
let splitWords text =
  splitWordsGo text 0 "" [];


# mostFrequentWords :: Int -> String -> [{word: String, count: Int}]
let mostFrequentWords k text =
  let words =
    splitWords text
  in
  let distinct =
    unique words
  in
  let counts =
    map
      (fn word =>
        {
          word = word,
          count = countEqual1 word words
        })
      distinct
  in
  let ranked =
    sortBy
      (fn a b =>
        a.count >= b.count)
      counts
  in
  take k ranked;

type BinTree a
  = Empty
  | Node a (BinTree a) (BinTree a);

# flatten :: BinTree a -> [a]
let flatten tree =
  match tree {
    Empty =>
      ____;
    Node value left right =>
      append
        (flatten ____)
        (____ :: flatten ____);
  };

# listToBST :: [Int] -> BinTree Int
let listToBST xs =
  match xs {
    [] =>
      ____;

    root :: rest =>
      let smaller =
        filter
          (fn x => x ____ root)
          rest
      in
      let larger =
        filter
          (fn x => x ____ root)
          rest
      in
      Node
        ____
        (listToBST ____)
        (listToBST ____);
  };

# notSoQuickSort :: [Int] -> [Int]
let notSoQuickSort xs =
  ____ (____ xs);