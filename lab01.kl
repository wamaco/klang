# PART 1

# square1 :: Int -> Int
let square1 n =
  n * n;

# mul :: Int -> Int -> Int
let mul a b = a * b;

# square2 :: Int -> Int
let square2 n =
  mul n n;

# prodOfSquares1 :: Int -> Int -> Int
let prodOfSquares1 a b =
  square1 a * square1 b;

# prodOfSquares2 :: Int -> Int -> Int
let prodOfSquares2 a b =
  (a * a) * (b * b);

# prodOfSquares3 :: Int -> Int -> Int
let prodOfSquares3 a b = {
  let a2 = a * a;
  let b2 = b * b;
  a2 * b2
};

# prodOfSquares4 :: Int -> Int -> Int
let prodOfSquares4 a b =
  let a2 = a * a in
  let b2 = b * b in
  a2 * b2;

# sumOfSquares1 :: Int -> Int -> Int
let sumOfSquares1 a b =
  square1 a + square1 b;

# sumOfSquares2 :: Int -> Int -> Int
let sumOfSquares2 a b = {
  let a2 = a * a;
  let b2 = b * b;
  a2 + b2
};

# sumOfSquares3 :: Int -> Int -> Int
let sumOfSquares3 a b =
  let a2 = a * a in
  let b2 = b * b in
  a2 + b2;

# PART 2

# double1 :: Int -> Int
let double1 n =
  n * 2;

# double2 :: Int -> Int
let double2 =
  fn n => n * 2;

# double3 :: Int -> Int
let double3 =
  mul 2;

# add1 :: Int -> Int -> Int
let add1 a b =
  a + b;

# add2 :: Int -> Int -> Int
let add2 =
  fn a b => a + b;

# addCurried :: Int -> Int -> Int
let addCurried =
  fn a =>
    fn b => a + b;

# addTen :: Int -> Int
let addTen =
  addCurried 10;

# addFive1 :: Int -> Int
let addFive1 x =
  x + 5;

# addFive2 :: Int -> Int
let addFive2 =
  add1 5;

# addFive3 :: Int -> Int
let addFive3 =
  addCurried 5;

# apply1 :: (a -> b) -> a -> b
let apply1 f x =
  f x;

# apply2 :: (a -> b) -> a -> b
let apply2 =
  fn f x => f x;

# applyTwice1 :: (a -> a) -> a -> a
let applyTwice1 f x =
  f (f x);

# applyTwice2 :: (a -> a) -> a -> a
let applyTwice2 f x =
  apply1 f (f x);

# compose :: (b -> c) -> (a -> b) -> a -> c
let compose f g x =
  f (g x);

# increment :: Int -> Int
let increment n = n + 1;

# incSquare1 :: Int -> Int
let incSquare1 n =
  square1 (increment n);

# incSquare2 :: Int -> Int
let incSquare2 =
  compose square1 increment;

# quadruple1 :: Int -> Int
let quadruple1 n =
  double1 (double1 n);

# quadruple2 :: Int -> Int
let quadruple2 =
  applyTwice1 double1;

# quadruple3 :: Int -> Int
let quadruple3 =
  compose double1 double1;

# PART 3

# abs1 :: Int -> Int
let abs1 n =
  if n < 0 then
    -n
  else
    n;

# max2 :: Int -> Int -> Int
let max2 a b =
  if a >= b then
    a
  else
    b;

# signText1 :: Int -> String
let signText1 n =
  if n > 0 then
    "+"
  else if n < 0 then
    "-"
  else
    "";

type Sign
  = Positive
  | Negative
  | Zero;

# sign1 :: Int -> Sign
let sign1 n =
  if n > 0 then
    Positive
  else if n < 0 then
    Negative
  else
    Zero;

# signText2 :: Sign -> String
let signText2 sign =
  match sign {
    Positive => "+";
    Negative => "-";
    Zero => "";
  };

# signText3 :: Int -> String
let signText3 n =
  signText2 (sign1 n);

type User
  = LoggedIn String
  | Guest;

# browseMessage :: User -> String
let browseMessage user =
  match user {
    LoggedIn name =>
      str_concat "Browsing as " name;
    Guest =>
      "Browsing as guest";
  };

# PART 4

# makePoint :: a -> b -> {x: a, y: b}
let makePoint x y =
  { x = x
  , y = y
  };

# sumPoint1 :: {x: Int, y: Int} -> Int
let sumPoint1 p =
  p.x + p.y;

# sumPoint2 :: {x: Int, y: Int} -> Int
let sumPoint2 p = {
  let { x, y } = p;
  x + y
};

# sumPoint3 :: {x: Int, y: Int} -> Int
let sumPoint3 p =
  let { x, y } = p in
  x + y;

# swapPoint1 :: {x: a, y: b} -> {x: b, y: a}
let swapPoint1 p =
  { x = p.y
  , y = p.x
  };

# swapPoint2 :: {x: a, y: b} -> {x: b, y: a}
let swapPoint2 p = {
  let { x, y } = p;
  {
    x = y,
    y = x
  }
};

# translatePoint :: Int -> Int -> {x: Int, y: Int} -> {x: Int, y: Int}
let translatePoint dx dy p =
  { x = p.x + dx
  , y = p.y + dy
  };

# PART 5

# prepend :: a -> [a] -> [a]
let prepend x xs =
  x :: xs;

# singleton :: a -> [a]
let singleton x =
  x :: [];

# headOr1 :: a -> [a] -> a
let headOr1 fallback xs =
  match xs {
    x :: _ => x;
    [] => fallback;
  };

type Option a
  = None
  | Some a;

# headOption :: [a] -> Option a
let headOption xs =
  match xs {
    x :: _ => Some x;
    [] => None;
  };

# headOr2 :: a -> [a] -> a
let headOr2 fallback xs =
  match headOption xs {
    Some x => x;
    None => fallback;
  };

# length1 :: [a] -> Int
let length1 xs =
  match xs {
    [] =>
      0;
    _ :: rest =>
      1 + length1 rest;
  };

# length2 :: [a] -> Int
let length2 xs =
  match xs {
    [] =>
      0;
    _ :: rest =>
      let restLength = length2 rest in
      1 + restLength;
  };

# sumList :: [Int] -> Int
let sumList xs =
  match xs {
    [] =>
      0;
    x :: rest =>
      x + sumList rest;
  };

# append :: [a] -> [a] -> [a]
let append xs ys =
  match xs {
    [] =>
      ys;
    x :: rest =>
      x :: append rest ys;
  };

# map :: (a -> b) -> [a] -> [b]
let map f xs =
  match xs {
    [] =>
      [];
    x :: rest =>
      f x :: map f rest;
  };

# filter :: (a -> Bool) -> [a] -> [a]
let filter keep xs =
  match xs {
    [] =>
      [];
    x :: rest =>
      if keep x then
        x :: filter keep rest
      else
        filter keep rest;
  };

# countEqual1 :: a -> [a] -> Int
let countEqual1 value xs =
  match xs {
    [] =>
      0;
    x :: rest =>
      if x == value then
        1 + countEqual1 value rest
      else
        countEqual1 value rest;
  };

# countEqual2 :: a -> [a] -> Int
let countEqual2 value xs =
  length1
    (filter
      (fn x => x == value)
      xs);

# member :: a -> [a] -> Bool
let member value xs =
  match xs {
    [] =>
      false;
    x :: rest =>
      if x == value then
        true
      else
        member value rest;
  };

# unique :: [a] -> [a]
let unique xs =
  match xs {
    [] =>
      [];
    x :: rest =>
      if member x rest then
        unique rest
      else
        x :: unique rest;
  };

# take :: Int -> [a] -> [a]
let take n xs =
  if n <= 0 then
    []
  else
    match xs {
      [] =>
        [];
      x :: rest =>
        x :: take (n - 1) rest;
    };

# sortBy :: (a -> a -> Bool) -> [a] -> [a]
let sortBy before xs =
  match xs {
    [] =>
      [];

    pivot :: rest =>
      let earlier =
        filter
          (fn x => before x pivot)
          rest
      in
      let later =
        filter
          (fn x =>
            if before x pivot then
              false
            else
              true)
          rest
      in
      append
        (sortBy before earlier)
        (pivot :: sortBy before later);
  };

